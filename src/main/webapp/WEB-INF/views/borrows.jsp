<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.ResultSet" %>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><title>借阅管理</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<header><b>高校图书管理系统</b><span><a href="${pageContext.request.contextPath}/logout">退出</a></span></header><nav><a href="${pageContext.request.contextPath}/dashboard">首页</a><a href="${pageContext.request.contextPath}/books">图书管理</a><a href="${pageContext.request.contextPath}/readers">读者管理</a><a class="active" href="${pageContext.request.contextPath}/borrows">借阅管理</a></nav>
<main><h2>借阅管理</h2><section class="panel"><h3>借阅登记</h3><form method="post" class="form-grid"><input type="hidden" name="action" value="borrow"><label>图书<select name="bookId"><% ResultSet bs=(ResultSet)request.getAttribute("books");while(bs.next()){ %><option value="<%=bs.getLong("id")%>"><%=bs.getString("title")%>（可借：<%=bs.getInt("available_count")%>）</option><%}bs.close();%></select></label><label>读者<select name="readerId"><% ResultSet rr=(ResultSet)request.getAttribute("readers");while(rr.next()){ %><option value="<%=rr.getLong("id")%>"><%=rr.getString("reader_no")%> - <%=rr.getString("name")%></option><%}rr.close();%></select></label><button>确认借阅</button></form></section>
<section class="panel"><h3>借阅记录</h3><table><tr><th>编号</th><th>图书</th><th>读者</th><th>借阅日期</th><th>应还日期</th><th>归还日期</th><th>状态</th><th>操作</th></tr>
<% ResultSet records=(ResultSet)request.getAttribute("records");while(records.next()){ %><tr><td><%=records.getLong("id")%></td><td><%=records.getString("title")%></td><td><%=records.getString("name")%></td><td><%=records.getDate("borrow_date")%></td><td><%=records.getDate("due_date")%></td><td><%=records.getDate("return_date")%></td><td><%= "BORROWED".equals(records.getString("status"))?"借出":"已归还"%></td><td><% if("BORROWED".equals(records.getString("status"))){ %><form method="post"><input type="hidden" name="action" value="return"><input type="hidden" name="id" value="<%=records.getLong("id")%>"><button class="small">办理归还</button></form><% } %></td></tr><%}records.close();%>
</table></section></main></body></html>
