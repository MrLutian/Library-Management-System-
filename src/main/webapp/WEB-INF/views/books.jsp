<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.ResultSet" %>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><title>图书管理</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<header><b>高校图书管理系统</b><span><a href="${pageContext.request.contextPath}/logout">退出</a></span></header><nav><a href="${pageContext.request.contextPath}/dashboard">首页</a><a class="active" href="${pageContext.request.contextPath}/books">图书管理</a><a href="${pageContext.request.contextPath}/readers">读者管理</a><a href="${pageContext.request.contextPath}/borrows">借阅管理</a></nav>
<main><h2>图书管理</h2><section class="panel"><h3>新增图书</h3><form class="form-grid" method="post"><input name="isbn" placeholder="ISBN"><input name="title" placeholder="图书名称" required><input name="author" placeholder="作者"><input name="publisher" placeholder="出版社"><input name="totalCount" type="number" min="0" placeholder="总数量" required><input name="availableCount" type="number" min="0" placeholder="可借数量" required><button>保存图书</button></form></section>
<section class="panel"><h3>图书列表</h3><table><tr><th>ID</th><th>ISBN</th><th>书名</th><th>作者</th><th>出版社</th><th>总数</th><th>可借</th><th>操作</th></tr>
<% ResultSet rs=(ResultSet)request.getAttribute("books"); while(rs.next()){ %><tr><td><%=rs.getLong("id")%></td><td><%=rs.getString("isbn")%></td><td><%=rs.getString("title")%></td><td><%=rs.getString("author")%></td><td><%=rs.getString("publisher")%></td><td><%=rs.getInt("total_count")%></td><td><%=rs.getInt("available_count")%></td><td><a class="danger" href="?action=delete&id=<%=rs.getLong("id")%>" onclick="return confirm('确定删除？')">删除</a></td></tr><% } rs.close(); %>
</table></section></main></body></html>
